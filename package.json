{
  "name": "@saiprasad4/sahaj",
  "version": "0.0.1",
  "description": "AA-agnostic SDK for India's Account Aggregator ecosystem: run the full consent-to-data loop in a zero-registration sandbox, get typed and parsed ReBIT financial data. Independent open-source library.",
  "keywords": [
    "account-aggregator",
    "aa",
    "rebit",
    "fiu",
    "fip",
    "open-banking",
    "consent",
    "financial-data",
    "india",
    "fintech",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Saiprasad Shankar",
    "email": "saiprasad.shankar@gmail.com",
    "url": "https://github.com/saiprasad4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiprasad4/sahaj.git"
  },
  "homepage": "https://github.com/saiprasad4/sahaj#readme",
  "bugs": {
    "url": "https://github.com/saiprasad4/sahaj/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/quickstart.ts",
    "docs:errors": "tsx scripts/generate-error-docs.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
